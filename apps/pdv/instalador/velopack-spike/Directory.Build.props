<!--
  Spike do Velopack (F3-B8; README do PDV › decisão 100): protótipo DESCARTÁVEL, fora do GenesisPDV.slnx, do instalador e
  de qualquer build do PDV. Este arquivo e o Directory.Packages.props daqui param a busca do MSBuild: nada do
  apps/pdv/Directory.*.props (a versão 0.13.0 do PDV, as versões centrais) entra aqui, e nada daqui entra no PDV.
  Sai do repositório no F3-B33, quando o empacotamento de verdade (apps/pdv/instalador/velopack/) o substitui.
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Company>Genesis</Company>
    <Product>GenesisPDV (spike do Velopack)</Product>
    <NeutralLanguage>pt-BR</NeutralLanguage>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
