<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GenesisPDV.App.ViewModels"
             x:Class="GenesisPDV.App.Views.RestaurarBackupView"
             x:DataType="vm:RestaurarBackupViewModel"
             Classes="tela"
             Focusable="True">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Enter" Command="{Binding AvancarCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding VoltarCommand}" />
    <KeyBinding Gesture="Up" Command="{Binding MoverCommand}" CommandParameter="-1" />
    <KeyBinding Gesture="Down" Command="{Binding MoverCommand}" CommandParameter="1" />
  </UserControl.KeyBindings>
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Classes="barra" Padding="20,10">
      <TextBlock Text="GenesisPDV · Backup local" FontWeight="SemiBold" FontSize="16" />
    </Border>
    <Border Grid.Row="1" Classes="painel" Width="760" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="12">
        <TextBlock x:Name="TituloRestauracao" Text="{Binding Titulo}" Classes="titulo" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Motivo}" TextWrapping="Wrap" Foreground="{DynamicResource PincelErro}"
                   IsVisible="{Binding Motivo, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <StackPanel Spacing="8" IsVisible="{Binding Escolhendo}">
          <TextBlock Text="Escolha o backup (o mais novo primeiro). O banco em uso fica guardado." Classes="rotulo" />
          <ListBox x:Name="ListaBackups" ItemsSource="{Binding Backups}" SelectedIndex="{Binding Selecionado}" MaxHeight="300" Focusable="False">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LinhaBackup">
                <TextBlock Text="{Binding Texto}" Classes="mono" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
        <StackPanel Spacing="8" IsVisible="{Binding Liberando}">
          <TextBlock Text="Liberação: usuário e PIN de quem tem a permissão de configurar o terminal" Classes="rotulo" />
          <TextBox x:Name="CampoUsuarioRestauracao" Text="{Binding Usuario}" AutomationProperties.Name="Usuário que libera" />
          <TextBox x:Name="CampoPinRestauracao" Text="{Binding Pin}" PasswordChar="●" AutomationProperties.Name="PIN de quem libera" />
        </StackPanel>
        <StackPanel Spacing="8" IsVisible="{Binding Confirmando}">
          <TextBlock Text="{Binding Escolhido.Texto, StringFormat='Restaurar {0}'}" TextWrapping="Wrap" />
          <TextBlock x:Name="TextoConfirmacaoRestauracao" Text="{Binding TextoConfirmacao}" Classes="rotulo" TextWrapping="Wrap" />
          <TextBox x:Name="CampoConfirmacaoRestauracao" Text="{Binding Confirmacao}" AutomationProperties.Name="Confirmação da restauração" />
        </StackPanel>
        <TextBlock x:Name="TextoResultadoRestauracao" Text="{Binding Resultado}" TextWrapping="Wrap" FontSize="16"
                   IsVisible="{Binding Resultado, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock x:Name="TextoErroRestauracao" Text="{Binding Erro}" Classes="erro" TextWrapping="Wrap"
                   IsVisible="{Binding Erro, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </Border>
    <Border Grid.Row="2" Classes="barra" Padding="20,8">
      <TextBlock Classes="secundario" Text="{Binding Rodape}" />
    </Border>
  </Grid>
</UserControl>
