<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GenesisPDV.App.ViewModels"
             xmlns:c="using:GenesisPDV.App.Comportamentos"
             x:Class="GenesisPDV.App.Views.LoginView"
             x:DataType="vm:LoginViewModel"
             Classes="tela">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Enter" Command="{Binding EntrarCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding LimparCommand}" />
    <KeyBinding Gesture="Ctrl+Alt+C" Command="{Binding AbrirCentralCommand}" />
  </UserControl.KeyBindings>
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Classes="barra" Padding="20,10">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Cabecalho}" FontWeight="SemiBold" />
        <TextBlock Text="GenesisPDV" FontWeight="Bold" FontSize="16" />
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Classes="painel" Width="460" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="10">
        <TextBlock Text="Entrar no caixa" Classes="titulo" x:Name="TituloLogin" />
        <TextBlock Text="Usuário (login ou código)" Classes="rotulo" />
        <TextBox x:Name="CampoUsuario" Text="{Binding Usuario}" AutomationProperties.Name="Usuário" c:Foco.Inicial="True" />
        <TextBlock Text="PIN (senha do PDV)" Classes="rotulo" />
        <TextBox x:Name="CampoSenha" Text="{Binding Senha}" PasswordChar="●" AutomationProperties.Name="PIN" />
        <TextBlock x:Name="TextoErroLogin" Text="{Binding Erro}" Classes="erro" IsVisible="{Binding Erro, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
          <Button Content="[Enter] Entrar" Command="{Binding EntrarCommand}" Classes="accent" />
          <Button Content="[Esc] Limpar" Command="{Binding LimparCommand}" />
        </StackPanel>
        <!-- A engrenagem (Central do PDV, bloco G3): o mesmo do Ctrl+Alt+C, para quem usa o mouse. -->
        <Button x:Name="BotaoCentralLogin" Content="⚙  Central do PDV (Ctrl+Alt+C)" Command="{Binding AbrirCentralCommand}"
                Focusable="False" HorizontalAlignment="Left" Margin="0,4,0,0"
                ToolTip.Tip="Impressora e gaveta, Restaurar backup e o diagnóstico do caixa" />
        <TextBlock x:Name="TextoAvisoVersao" Text="{Binding AvisoVersao}" Classes="indicador" TextWrapping="Wrap" FontSize="13" Margin="0,8,0,0"
                   IsVisible="{Binding AvisoVersao, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Text="{Binding Dica}" IsVisible="{Binding Dica, Converter={x:Static ObjectConverters.IsNotNull}}" Classes="secundario" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />
      </StackPanel>
    </Border>
    <Border Grid.Row="2" Classes="barra" Padding="20,8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Versao}" Classes="secundario" />
        <StackPanel Orientation="Horizontal" Spacing="18">
          <TextBlock x:Name="TextoConexaoLogin" Text="{Binding ConexaoTexto}" Classes="indicador" AutomationProperties.Name="Conexão" />
          <TextBlock Text="{Binding Pendentes, StringFormat='Pendentes: {0}'}" Classes="secundario" />
          <TextBlock Text="Ctrl+Alt+C ⚙ Central do PDV (impressora, backup, diagnóstico)   Alt+F4 Sair" Classes="secundario" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
