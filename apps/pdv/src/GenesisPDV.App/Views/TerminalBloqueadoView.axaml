<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GenesisPDV.App.ViewModels"
             x:Class="GenesisPDV.App.Views.TerminalBloqueadoView"
             x:DataType="vm:TerminalBloqueadoViewModel"
             Classes="tela"
             Focusable="True">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Enter" Command="{Binding TentarDeNovoCommand}" />
    <KeyBinding Gesture="F2" Command="{Binding Pacote.GerarCommand}" />
  </UserControl.KeyBindings>
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Classes="barra" Padding="20,10">
      <TextBlock Text="GenesisPDV · Status do terminal" FontWeight="SemiBold" FontSize="16" />
    </Border>
    <Border Grid.Row="1" Classes="painel" Width="680" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="12">
        <TextBlock x:Name="TituloBloqueio" Text="{Binding Titulo}" Classes="titulo" Foreground="{DynamicResource PincelErro}" TextWrapping="Wrap"
                   AutomationProperties.Name="Status do terminal" />
        <TextBlock x:Name="TextoBloqueio" Text="{Binding Mensagem}" TextWrapping="Wrap" FontSize="16" />
        <Border Background="{DynamicResource PincelPainelAlto}" CornerRadius="4" Padding="12,8">
          <TextBlock x:Name="TextoDiagnostico" Text="{Binding Diagnostico}" Classes="mono" TextWrapping="Wrap" FontSize="13" />
        </Border>
        <Button Content="[Enter] Tentar de novo" Command="{Binding TentarDeNovoCommand}" Focusable="False"
                IsVisible="{Binding PodeTentarDeNovo}" IsEnabled="{Binding !Tentando}" HorizontalAlignment="Left" />
        <!-- O pacote para o suporte sem login (Central do PDV, bloco G9; decisão 76): o manifesto, os logs e este diagnóstico. -->
        <Button x:Name="BotaoPacoteBloqueado" Content="[F2] Gerar pacote para o suporte" Command="{Binding Pacote.GerarCommand}" Focusable="False" MinHeight="44"
                IsEnabled="{Binding !Pacote.Ocupado}" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding Pacote.Aviso}" Classes="secundario" TextWrapping="Wrap" />
        <TextBlock x:Name="TextoPacoteBloqueado" Text="{Binding Pacote.Mensagem}" TextWrapping="Wrap" FontWeight="SemiBold"
                   IsVisible="{Binding Pacote.Mensagem, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock x:Name="TextoErroPacoteBloqueado" Text="{Binding Pacote.Erro}" Classes="erro" TextWrapping="Wrap"
                   IsVisible="{Binding Pacote.Erro, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </Border>
    <Border Grid.Row="2" Classes="barra" Padding="20,8">
      <TextBlock Classes="secundario" Text="{Binding Rodape}" />
    </Border>
  </Grid>
</UserControl>
