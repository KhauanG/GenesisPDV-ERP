<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GenesisPDV.App.ViewModels"
             x:Class="GenesisPDV.App.Views.TelaBloqueadaView"
             x:DataType="vm:TelaBloqueadaViewModel"
             Classes="tela"
             Focusable="True">
  <!-- Tela bloqueada (PDV 7.4; Central do PDV, bloco G11): a venda fica guardada atrás; só o PIN do operador ou o
       supervisor (F2) desbloqueia. Tudo também pelo mouse (decisão 65). -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Enter" Command="{Binding DesbloquearCommand}" />
    <KeyBinding Gesture="F2" Command="{Binding SupervisorCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding VoltarCommand}" />
  </UserControl.KeyBindings>
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Classes="barra" Padding="20,10">
      <TextBlock Text="GenesisPDV · Tela bloqueada" FontWeight="SemiBold" FontSize="16" />
    </Border>
    <Border Grid.Row="1" Classes="painel" Width="560" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="10">
        <TextBlock x:Name="TituloTelaBloqueada" Text="🔒 Tela bloqueada" Classes="titulo" AutomationProperties.Name="Tela bloqueada" />
        <TextBlock x:Name="TextoOperadorBloqueio" Text="{Binding OperadorTexto}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="TextoDescricaoBloqueio" Text="{Binding Descricao}" TextWrapping="Wrap" Classes="secundario" />
        <TextBlock x:Name="TextoVendaGuardada" Text="{Binding VendaTexto}" TextWrapping="Wrap" FontWeight="SemiBold"
                   Foreground="{DynamicResource PincelAviso}" IsVisible="{Binding VendaTexto, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <StackPanel Spacing="6" IsVisible="{Binding PeloPin}">
          <TextBlock Text="PIN de quem está no caixa" Classes="rotulo" />
          <TextBox x:Name="CampoPinDesbloqueio" Text="{Binding Pin}" PasswordChar="●" AutomationProperties.Name="PIN do operador" />
        </StackPanel>
        <StackPanel Spacing="6" IsVisible="{Binding PeloSupervisor}">
          <TextBlock Text="Supervisor (login ou código)" Classes="rotulo" />
          <TextBox x:Name="CampoSupervisorDesbloqueio" Text="{Binding UsuarioSupervisor}" AutomationProperties.Name="Supervisor que desbloqueia" />
          <TextBlock Text="PIN do supervisor" Classes="rotulo" />
          <TextBox x:Name="CampoPinSupervisorDesbloqueio" Text="{Binding PinSupervisor}" PasswordChar="●" AutomationProperties.Name="PIN do supervisor" />
        </StackPanel>
        <TextBlock x:Name="TextoErroDesbloqueio" Text="{Binding Erro}" Classes="erro" TextWrapping="Wrap"
                   IsVisible="{Binding Erro, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <WrapPanel Classes="botoes">
          <Button Classes="acao accent" x:Name="BotaoDesbloquear" Content="Enter  Desbloquear" Command="{Binding DesbloquearCommand}"
                  IsEnabled="{Binding !Verificando}" MinHeight="44" />
          <Button Classes="acao" x:Name="BotaoSupervisorDesbloqueia" Content="F2  O supervisor desbloqueia" Command="{Binding SupervisorCommand}"
                  IsVisible="{Binding PeloPin}" MinHeight="44" />
          <Button Classes="acao" x:Name="BotaoVoltarPin" Content="Esc  Voltar ao PIN do operador" Command="{Binding VoltarCommand}"
                  IsVisible="{Binding PeloSupervisor}" MinHeight="44" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <Border Grid.Row="2" Classes="barra" Padding="20,8">
      <TextBlock x:Name="RodapeTelaBloqueada" Classes="secundario" Text="{Binding Rodape}" />
    </Border>
  </Grid>
</UserControl>
