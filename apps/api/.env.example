# Copie para .env (desenvolvimento) ou .env.<AMBIENTE>. Variáveis do processo têm prioridade sobre os arquivos.
# Linha "CHAVE=" vazia vale como variável ausente (usa o padrão).
# Ambientes: desenvolvimento | teste | homologacao | producao. Com NODE_ENV=production a API recusa
# desenvolvimento/teste: defina AMBIENTE explicitamente em todo deploy.
AMBIENTE=desenvolvimento
PORTA=3000
LOG_NIVEL=info
# Logs legíveis no terminal (pino-pretty). Em homologação/produção deixe false (JSON estruturado).
LOG_LEGIVEL=true

# Banco de controle (genesis_control). O mesmo servidor/credenciais vira o "servidor padrão" das empresas.
DATABASE_URL=postgres://genesis:genesis_dev@127.0.0.1:5432/genesis_control
# Servidor PostgreSQL padrão dos bancos de empresa (vazio = o do DATABASE_URL). A role precisa de CREATEDB.
# EMPRESAS_SERVIDOR_URL=postgres://genesis:genesis_dev@127.0.0.1:5432/postgres
# Colação ICU dos bancos de empresa; deixe vazio se o servidor não tiver ICU.
EMPRESAS_ICU_LOCALE=pt-BR

# Segredos: obrigatórios fora de desenvolvimento/teste (os padrões de desenvolvimento são recusados lá) e os dois
# segredos JWT devem ser diferentes. Gere com: openssl rand -base64 48
# JWT_SEGREDO=
# JWT_SEGREDO_PLATAFORMA=
# Chave mestra AES-256-GCM dos segredos (MD 1.10): base64 de 32 bytes (openssl rand -base64 32).
# CHAVE_MESTRA=
CHAVE_MESTRA_VERSAO=1
# Rotação: chaves antigas ainda usadas para decifrar, no formato versao:base64,versao:base64
# CHAVES_MESTRAS_ANTERIORES=

# ERP web (CORS com credenciais) e cookie do refresh token (Secure fora de desenvolvimento/teste)
CORS_ORIGENS=http://localhost:5173
# COOKIE_SEGURO=true

# Proxies confiáveis à frente da API (define o IP do cliente para limite de taxa e auditoria): número de saltos
# (ex.: 1 com um balanceador), false (acesso direto) ou lista de IPs/CIDRs (ex.: 10.0.0.0/8,loopback).
# Obrigatória em homologação/produção; em desenvolvimento/teste o padrão é false.
# TRUST_PROXY=1

# Sessão e login (ERP 4.1)
ACESSO_TOKEN_MINUTOS=15
REFRESH_DIAS=7
SESSAO_INATIVIDADE_MINUTOS=60
SESSAO_ADMIN_INATIVIDADE_MINUTOS=30
# Refresh já rotacionado que reaparece dentro desta janela (requisições simultâneas) → 409 sem derrubar a sessão
REFRESH_TOLERANCIA_SEGUNDOS=20
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15
# Limites por minuto: por IP e por conta (código da empresa + login; e-mail no painel)
LOGIN_LIMITE_POR_MINUTO=20
LOGIN_LIMITE_POR_CONTA_MINUTO=10

# Multiempresa: cache de pools por empresa (ADR-02)
POOL_CACHE_MAXIMO=50
POOL_OCIOSO_MS=300000
POOL_CONEXOES_POR_EMPRESA=5
# Cache da resolução empresa → banco (status/manutenção); 0 desliga
TENANCY_CACHE_MS=5000
# Cache do dashboard (ERP 6: 60 s por empresa × loja × mês); 0 desliga
DASHBOARD_CACHE_MS=60000

# db:migrate:empresas: servidores migrados em paralelo e lock_timeout de cada migração
MIGRACAO_LOTE=4
MIGRACAO_LOCK_TIMEOUT=10s
# Espera máxima (ms) do ERP pela trava de ordenação 7300001 antes do 503 SISTEMA_OCUPADO (Fase 1C, C13); 0 = sem limite
ERP_ESPERA_TRAVA_MS=5000

# ERP web: base dos links enviados por e-mail (redefinição de senha)
ERP_URL=http://localhost:5173
# Consulta de CEP (ERP 7.2): modelo com {cep}; "desligada" desativa (o endereço é digitado)
CEP_CONSULTA_URL=https://viacep.com.br/ws/{cep}/json/
# E-mail transacional (em desenvolvimento, o Mailpit do docker-compose: caixa em http://localhost:8025)
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_REMETENTE=GenesisPDV <nao-responda@genesis.local>

# Armazenamento de objetos S3-compatível (MD 3.1.6). Em desenvolvimento/teste o padrão é o do docker-compose
# (http://127.0.0.1:9000, genesis / genesis_dev_minio); fora deles informe endpoint (vazio = AWS) e credenciais
# (vazias = cadeia padrão do SDK: AWS_*, perfil ou papel da instância).
# ARMAZENAMENTO_ENDPOINT=http://127.0.0.1:9000
ARMAZENAMENTO_REGIAO=us-east-1
ARMAZENAMENTO_BUCKET=genesis-dev
# ARMAZENAMENTO_CHAVE_ACESSO=
# ARMAZENAMENTO_CHAVE_SECRETA=
# Endereçamento por caminho (MinIO/RustFS); false para o estilo virtual-host da AWS
ARMAZENAMENTO_CAMINHO=true

# Fila de trabalhos (pg-boss, schema pgboss do banco de controle): esta instância também executa tarefas e e-mails
FILA_TRABALHADOR=true
# Verificação periódica do razão de estoque (cron em UTC, 5 campos; vazia = desligada, o padrão, e remove o agendamento
# gravado antes): só confere saldos_estoque com o razão e abre o alerta RAZAO_SALDO_DIVERGENTE; corrigir é o
# db:recalcular-saldos --corrigir. Cron inválido recusa a subida da API (decisão 147)
# VERIFICACAO_RAZAO_CRON=41 6 * * *

# Limites de recurso do processo (compartilhado por todas as empresas; src/comum/limites-processo.ts)
# argon2 simultâneos (o PIN usa 64 MiB por chamada) e leituras de planilha simultâneas
# ARGON2_CONCORRENCIA=4
# PLANILHA_CONCORRENCIA=2
# Hashes (PIN, senha do cliente, senha de liberação) e prévias de importação por usuário por minuto
# HASH_LIMITE_POR_MINUTO=10
# IMPORTACAO_PREVIAS_POR_MINUTO=10

# Painel do monitoramento GET /api/saude/detalhada (Implantação do piloto, I1b; infra/producao/README.md ›
# Monitoramento): SHA-256 (hex) do token só de leitura. Vazio = a rota responde 401 a qualquer token. Na VPS, o
# implantar.sh token-monitor gera o token e grava só o hash. Ex.: printf '%s' "$TOKEN" | sha256sum
# MONITOR_TOKEN_SHA256=
# Consultas por IP por minuto (as recusadas também contam)
# MONITOR_LIMITE_POR_MINUTO=30
# Chave do estado do último backup no bucket (gravada pelo genesis-backup)
# BACKUP_ESTADO_CHAVE=backups/estado.json
# Versão mostrada no painel (a imagem de produção define com o commit)
# GENESIS_VERSAO=desenvolvimento
