{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "API na nuvem do GenesisPDV & ERP (NestJS + Drizzle + PostgreSQL)",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run && vitest run -c vitest.integracao.config.ts",
    "test:unit": "vitest run",
    "test:integracao": "vitest run -c vitest.integracao.config.ts",
    "test:sync-triggers": "vitest run -c vitest.integracao.config.ts test/integracao/sync-triggers.test.ts",
    "test:limpar": "tsx test/limpar-bancos.ts",
    "e2e:pdv:servidor": "tsx test/e2e-pdv/servidor.ts",
    "db:gerar:controle": "drizzle-kit generate --config drizzle.controle.config.ts",
    "db:gerar:empresa": "drizzle-kit generate --config drizzle.empresa.config.ts",
    "db:migrate:controle": "tsx src/cli/migrar-controle.ts",
    "db:migrate:empresas": "tsx src/cli/migrar-empresas.ts",
    "db:referencias": "tsx src/cli/referencias.ts",
    "db:ncm:atualizar": "tsx src/cli/ncm-atualizar.ts",
    "db:particoes": "tsx src/cli/particoes.ts",
    "db:preencher-seq-lancamento": "tsx src/cli/preencher-seq-lancamento.ts",
    "db:recalcular-saldos": "tsx src/cli/recalcular-saldos.ts",
    "carga:razao": "node --expose-gc --import tsx test/carga/massa-razao.ts",
    "carga:exportacao": "node --expose-gc --max-old-space-size=1536 --import tsx test/carga/exportacao-razao.ts",
    "carga:estoque-atual": "node --max-old-space-size=1536 --import tsx test/carga/estoque-atual.ts",
    "carga:movimentacao": "node --max-old-space-size=1536 --import tsx test/carga/movimentacao.ts",
    "carga:movimentacao-exportacao": "node --expose-gc --max-old-space-size=1536 --import tsx test/carga/movimentacao-exportacao.ts",
    "empresa:criar": "tsx src/cli/empresa-criar.ts",
    "empresa:provisionamento": "tsx src/cli/empresa-provisionamento.ts",
    "admin:criar": "tsx src/cli/admin-criar.ts",
    "gerar:esquema-pdv": "tsx src/cli/gerar-esquema-pdv.ts",
    "verificar:esquema-pdv": "tsx src/cli/gerar-esquema-pdv.ts --verificar"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@genesis/shared": "workspace:*",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/throttler": "^6.7.1",
    "@xmldom/xmldom": "0.8.15",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cron-parser": "^5.10.2",
    "decimal.js": "10.6.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.2",
    "jose": "^6.2.14",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.3.1",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "read-excel-file": "9.3.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "uuidv7": "^1.2.1",
    "write-excel-file": "^4.1.1",
    "xml-crypto": "6.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "smtp-server": "^3.21.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
