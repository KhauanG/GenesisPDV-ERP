# ERP web – variáveis do Vite (copie para .env.local; nada aqui é segredo: tudo vai para o navegador).

# Para onde o servidor de desenvolvimento do Vite encaminha /api e /saude (a API NestJS local).
VITE_API_PROXY=http://localhost:3000

# Porta do servidor de desenvolvimento (a API aceita CORS de http://localhost:5173 por padrão).
VITE_PORTA=5173

# Rótulo do ambiente exibido no cabeçalho (vazio em produção). Ex.: desenvolvimento, homologacao.
VITE_AMBIENTE=desenvolvimento
