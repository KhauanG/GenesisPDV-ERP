# /opt/genesis/genesis.env — configuração NÃO secreta da API em produção (env_file da API e do container de tarefa).
# O instalar.sh copia este modelo uma vez; depois, edite o arquivo da VPS e rode o implantar.sh de novo (ou
# `docker compose up -d` em /opt/genesis) para valer.
# Os segredos ficam em /opt/genesis/segredos (root, 600): genesis-google.env (banco e armazenamento, gerado no Cloud
# Shell) e genesis-app.env (JWT_SEGREDO, JWT_SEGREDO_PLATAFORMA, CHAVE_MESTRA; gerado pelo instalar.sh).
# Variáveis e padrões: apps/api/README.md › Variáveis de ambiente.

AMBIENTE=producao
LOG_NIVEL=info

# Um proxy à frente da API: o Traefik da VPS (o IP do cliente vem do X-Forwarded-For que ele escreve).
TRUST_PROXY=1

# O ERP chama a API na própria origem (erp.<domínio>/api); o CORS só precisa da origem do ERP.
CORS_ORIGENS=https://erp.grupoicebeer.com.br
# Base dos links enviados por e-mail (redefinição de senha).
ERP_URL=https://erp.grupoicebeer.com.br
# Cookie de refresh só por HTTPS (padrão fora de desenvolvimento; explícito aqui).
COOKIE_SEGURO=true

# Bancos de empresa no mesmo servidor do genesis_control (o Cloud SQL, pelo proxy), com colação ICU pt-BR.
EMPRESAS_ICU_LOCALE=pt-BR

# Esta instância executa a fila (tarefas em segundo plano e e-mails).
FILA_TRABALHADOR=true

# E-mail transacional: OPCIONAL por enquanto (SMTP real da Hostinger fica para depois do I1). Sem SMTP, os e-mails
# (ex.: "esqueci a senha") falham na fila e o resto da API funciona. Quando houver, a URL com usuário e senha é
# SEGREDO: vai em segredos/genesis-app.env, nunca aqui. Ex.: SMTP_URL=smtps://usuario:senha@smtp.hostinger.com:465
EMAIL_REMETENTE=GenesisPDV <nao-responda@grupoicebeer.com.br>

# Consulta de CEP no cadastro (ViaCEP por padrão); `desligada` desativa.
# CEP_CONSULTA_URL=desligada

# Tabela NCM do Siscomex do `implantar.sh tarefa ncm-atualizar` (padrão: o endereço oficial do Portal Único).
# SISCOMEX_NCM_URL=https://portalunico.siscomex.gov.br/classif/api/publico/nomenclatura/download/json?perfil=PUBLICO
