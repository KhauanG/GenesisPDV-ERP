# /opt/genesis/.env — variáveis que o Docker Compose usa nos labels e nos caminhos do docker-compose.yml.
# O instalar.sh cria este arquivo uma vez (copiando o CLOUDSQL_INSTANCIA de segredos/genesis-google.env) e não o
# sobrescreve depois. Nada aqui é segredo. O implantar.sh mantém a linha GENESIS_VERSAO atualizada.

# Domínios (o DNS de cada um aponta para o IP da VPS; o Traefik pede o certificado ao Let's Encrypt).
ERP_DOMINIO=erp.grupoicebeer.com.br
API_DOMINIO=api.grupoicebeer.com.br
DOWNLOAD_DOMINIO=download.grupoicebeer.com.br

# Traefik que já roda na VPS (projeto icebeer): rede externa, entrypoint HTTPS e resolvedor de certificados.
REDE_PROXY=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Instância do Cloud SQL (nome de conexão projeto:região:instância).
CLOUDSQL_INSTANCIA=

# Pasta dos segredos (root, 700).
GENESIS_SEGREDOS=/opt/genesis/segredos

# Backup lógico diário (I1b): horário de Brasília (fora do pico; a manutenção do Cloud SQL é às terças, 04:00) e dias
# guardados no bucket.
BACKUP_HORARIO=04:30
BACKUP_RETENCAO_DIAS=14

# Versão em produção (commit de 12 caracteres); escrita pelo implantar.sh.
GENESIS_VERSAO=
